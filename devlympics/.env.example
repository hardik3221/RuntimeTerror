# Paste your four Groq API keys after the equals signs below.
# You may fill only 1-3 slots; blank slots are ignored.
# Keep this file beside server.js. Restart npm start after editing.
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# Keys from one Groq organization share its request/token quotas.
GROQ_MODEL=openai/gpt-oss-120b
PORT=3000
